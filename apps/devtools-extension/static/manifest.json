{
  "manifest_version": 3,
  "name": "Phosphor",
  "version": "0.1.0",
  "description": "See how your page reproduces on other displays: luminance, contrast, gamut, gamma, white point, bit depth, chroma.",
  "devtools_page": "devtools.html",
  "background": { "service_worker": "apps/devtools-extension/background.js", "type": "module" },
  "permissions": ["nativeMessaging", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "minimum_chrome_version": "116",
  "key": ""
}
